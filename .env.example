# Google Cloud deployment
APP_ENV=local
GOOGLE_CLOUD_PROJECT=bond-agent-509210
GOOGLE_CLOUD_REGION=asia-east1
GCS_BUCKET=
TASK_QUEUE=bond-agent-jobs
TASKS_SERVICE_URL=
TASKS_INVOKER_SERVICE_ACCOUNT=

# Database and model services
DATABASE_URL=postgresql+psycopg://bond_agent:bond_agent@db:5432/bond_agent
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
VERTEX_AI_LOCATION=global
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1024

# Local development and safety controls
LOCAL_STORAGE_DIR=/data/uploads
TASKS_SHARED_SECRET=change-me-before-local-use
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=80
OCR_DPI=200
PROJECT_RETENTION_DAYS=30
